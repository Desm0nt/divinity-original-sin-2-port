#version 450
// [DOS2] VK-ENGINE-SIDE I2 v2 (dm/gfx/vkn/vkn_eocc.h): the max and min depth of every 16 x 16 pixel cell of the depth pre-pass target, as
// technique Z's vkn_occz_reduce.comp, with one textureGather per 2 x 2 texel block instead of four fetches (the block's centre between
// its four texel centres; a block that crosses the edge of the area falls back to single fetches of its pixels inside the area).
// One workgroup = one cell; 8 x 8 threads, one 2 x 2 block each. Output: cell[y * gw + x] = max, cell[plane + y * gw + x] = min.
// Build: glslc -fshader-stage=compute --target-env=vulkan1.0 -O vkn_eocc_reduce.comp -mfmt=num -o vkn_eocc_reduce.comp.spv.inc
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D dep;
layout(binding = 1, std430) writeonly buffer Out { float cell[]; } o;
layout(push_constant) uniform P { ivec2 size; int gw; int plane; } pc;
shared float sx[64];
shared float sn[64];
void main() {
    const ivec2 c = ivec2(gl_WorkGroupID.xy);
    const ivec2 p0 = c * 16 + ivec2(gl_LocalInvocationID.xy) * 2;
    float mx = 0.0, mn = 1.0;
    if (p0.x + 1 < pc.size.x && p0.y + 1 < pc.size.y) {
        const vec4 g = textureGather(dep, (vec2(p0) + 1.0) / vec2(textureSize(dep, 0)), 0);
        mx = max(max(g.x, g.y), max(g.z, g.w)); mn = min(min(g.x, g.y), min(g.z, g.w));
    } else {
        for (int dy = 0; dy < 2; dy++)
            for (int dx = 0; dx < 2; dx++) {
                const ivec2 p = p0 + ivec2(dx, dy);
                if (p.x < pc.size.x && p.y < pc.size.y) { const float d = texelFetch(dep, p, 0).r; mx = max(mx, d); mn = min(mn, d); }
            }
    }
    const uint i = gl_LocalInvocationIndex;
    sx[i] = mx; sn[i] = mn;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (i < s) { sx[i] = max(sx[i], sx[i + s]); sn[i] = min(sn[i], sn[i + s]); }
        barrier();
    }
    if (i == 0u) { const int at = c.y * pc.gw + c.x; o.cell[at] = sx[0]; o.cell[pc.plane + at] = sn[0]; }
}
